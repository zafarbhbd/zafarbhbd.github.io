rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: true;
      allow write: if request.auth != null && request.auth.token.email == "YOUR_GOOGLE_EMAIL@gmail.com";
    }
    // Student passwords — students can write their own
    match /student_passwords/{regNo} {
      allow read: true;
      allow create: true;
      allow update, delete: if request.auth != null && request.auth.token.email == "YOUR_GOOGLE_EMAIL@gmail.com";
    }
    // Submissions — students can create, only admin deletes
    match /submissions/{subId} {
      allow read: true;
      allow create: true;
      allow delete: if request.auth != null && request.auth.token.email == "YOUR_GOOGLE_EMAIL@gmail.com";
    }
    // Attendance records — students can create P records
    match /attendance_records/{recId} {
      allow read: true;
      allow create: true;
      allow update, delete: if request.auth != null && request.auth.token.email == "YOUR_GOOGLE_EMAIL@gmail.com";
    }
  }
}
